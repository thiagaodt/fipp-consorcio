# Servidor
PORT=5000
FRONTEND_URL=http://localhost:3000

# Segredo usado para assinar o JWT (gere um valor aleatório e longo)
JWT_SECRET=troque-por-um-valor-aleatorio

# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=consorcio
DB_USER=root
DB_PASSWORD=

# AbacatePay (use a chave do modo de desenvolvimento para testar sem dinheiro real)
ABACATE_API_URL=https://api.abacatepay.com
ABACATE_API_KEY=
# Segredo cadastrado junto com a URL do webhook no painel do AbacatePay
ABACATE_WEBHOOK_SECRET=
